    "@mui/x-data-grid": "^8.11.3",
    "cv-graphql": "^2.13.2",
    "i18next": "^25.5.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.52.2",
    "react-i18next": "^15.7.3",
    "react-router-dom": "^6.30.1",
    "zod": "^4.1.5"
